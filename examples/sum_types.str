const assert_is = fun (T: Type) {
    fun (x: T) {}
}

const rec BinaryTree = .ILeaf(Int) | .SLeaf(String) | .Node(BinaryTree, BinaryTree)

//      .
//     / \
//       .
//      / \
//     .   
//    / \
assert_is(BinaryTree)(.Node(.ILeaf(24), .Node(.Node(.SLeaf("foo"), .ILeaf(42)), .SLeaf("bar"))))

const rec List: Fun(Type) -> Type = fun(T: Type) -> Type {
    .Nil | .Cons(T, List(T))
}

assert_is(List(Int))(.Cons(42, .Cons(69, .Nil)))
